{
  "hrrr": {
    "cache_dir": ".cache/hrrr",
    "domain": "conus",
    "product": "wrfprsf",
    "use_s3fs": true,
    "http_fallback": true,
    "download_workers": 8,
    "local_grib_dir": null,
    "keep_downloaded_files": true
  },
  "grid": {
    "half_width_east_m": 220000.0,
    "half_width_north_m": 220000.0,
    "min_altitude_m": -500.0,
    "max_altitude_m": 30000.0,
    "nx": 72,
    "ny": 72,
    "nz": 52,
    "gradient_step_m": 50.0,
    "wind_projection_mode": "heading"
  },
  "aircraft": {
    "mach": 1.08,
    "constant_altitude_m": 16500.0,
    "reference_sound_speed_mps": 340.29
  },
  "shock": {
    "emission_interval_s": 4.916916916916917,
    "rays_per_emission": 100,
    "downward_only": false,
    "cone_coverage": "full",
    "azimuth_offset_deg": 0.0,
    "direction_reference": "aircraft_forward"
  },
  "raytrace": {
    "ds_m": 200.0,
    "max_steps": 4500,
    "adaptive": true,
    "tol": 0.0008,
    "min_step_m": 25.0,
    "max_step_m": 1200.0,
    "stop_on_exit": true
  },
  "runtime": {
    "start_time_iso": null,
    "end_time_iso": null,
    "max_emissions": 1000,
    "ray_batch_size": 16
  },
  "population": {
    "enabled": false
  },
  "route_optimization": {
    "enabled": false
  },
  "visualization": {
    "enable_matplotlib": false,
    "enable_plotly": false,
    "enable_pyvista": false,
    "output_dir": "outputs/mia_jfk_highfid",
    "make_animation": false,
    "write_html": false,
    "include_atmosphere": true,
    "map_style": "topographic"
  }
}
